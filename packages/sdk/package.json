{
  "name": "@ghostgate/sdk",
  "version": "0.4.0",
  "description": "Ghost Protocol Node.js SDK for GhostGate Express, open x402, telemetry, fulfillment, and direct GhostWire escrow.",
  "author": "Ghost Protocol",
  "license": "MIT",
  "type": "module",
  "homepage": "https://ghostprotocol.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghost-Protocol-Infrastructure/GHOST_PROTOCOL.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Ghost-Protocol-Infrastructure/GHOST_PROTOCOL/issues"
  },
  "keywords": [
    "ghostprotocol",
    "ghostgate",
    "sdk",
    "fulfillment",
    "eip712",
    "x402",
    "telemetry",
    "base",
    "ghostwire",
    "escrow"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fulfillment": {
      "types": "./dist/fulfillment.d.ts",
      "import": "./dist/fulfillment.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "x402": "^1.1.0",
    "x402-fetch": "^1.1.0"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  }
}
